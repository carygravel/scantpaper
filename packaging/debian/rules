#!/usr/bin/make -f

export DH_VERBOSE=1

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --with python3 --buildsystem=pybuild

execute_after_dh_auto_build:
	python3 dev/compile_mo.py \
		--src po \
		--out debian/locale \
		--domain scantpaper

	pandoc README.md -o debian/documentation.html
	python3 dev/strip_remote_images.py debian/documentation.html

execute_after_dh_install:
	# install locale manually into package staging area
	mkdir -p debian/scantpaper/usr/share/
	mv debian/locale debian/scantpaper/usr/share/

execute_before_dh_installman:
	help2man \
		--no-info \
		--name="a GUI to produce PDFs or DjVus from scanned documents" \
		--output=$(CURDIR)/debian/scantpaper.1 \
		"PYTHONPATH=src python3 -m scantpaper.app"

override_dh_auto_test: ;
