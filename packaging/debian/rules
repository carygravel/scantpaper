#!/usr/bin/make -f

export DH_VERBOSE=1

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --with python3 --buildsystem=pybuild

execute_after_dh_auto_build:
	PYTHONPATH=src python3 dev/generate_pot.py
	python3 dev/compile_mo.py \
		--src po \
		--out debian/locale \
		--domain scantpaper \
		--approvals po/approvals \
		--pot po/scantpaper/scantpaper.pot \
		--report debian/translation-report.json

	python3 dev/join_metadata.py \
		--mo debian/locale \
		--out-dir debian/generated

	pandoc README.md -o debian/documentation.html
	python3 dev/strip_remote_images.py debian/documentation.html

execute_after_dh_install:
	# install locale manually into package staging area
	mkdir -p debian/scantpaper/usr/share/
	mv debian/locale debian/scantpaper/usr/share/
	# replace the English-only metadata with the joined translations
	cp debian/generated/org.scantpaper.desktop \
		debian/scantpaper/usr/share/applications/org.scantpaper.desktop
	cp debian/generated/org.scantpaper.desktop.metainfo.xml \
		debian/scantpaper/usr/share/metainfo/org.scantpaper.desktop.metainfo.xml

execute_before_dh_installman:
	help2man \
		--no-info \
		--name="a GUI to produce PDFs or DjVus from scanned documents" \
		--output=$(CURDIR)/debian/scantpaper.1 \
		"PYTHONPATH=src python3 -m scantpaper.app"

override_dh_auto_test: ;
