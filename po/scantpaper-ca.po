#: unpaper.py:141
msgid "Deskew to edge"
msgstr "Corregeix la inclinació fins a la vora"

#: unpaper.py:143
msgid ""
"Edges from which to scan for rotation. Each edge of a mask can be used to "
"detect the mask's rotation. If multiple edges are specified, the average "
"value will be used, unless the statistical deviation exceeds --deskew-scan-"
"deviation."
msgstr ""
"Vores des de les quals s'analitza la rotació. Cada vora d'una màscara es pot "
"utilitzar per detectar la rotació de la màscara. Si s'especifiquen diverses "
"vores, s'utilitzarà el valor mitjà, tret que la desviació estadística superi "
"--deskew-scan-deviation."

#: unpaper.py:152
msgid "Use 'left' for scanning from the left edge."
msgstr "Utilitzeu 'left' per analitzar des de la vora esquerra."

#: unpaper.py:157
msgid "Use 'top' for scanning from the top edge."
msgstr "Utilitzeu 'top' per analitzar des de la vora superior."

#: unpaper.py:161 unpaper.py:189
msgid "Right"
msgstr "Dreta"

#: unpaper.py:162
msgid "Use 'right' for scanning from the right edge."
msgstr "Utilitzeu 'right' per analitzar des de la vora dreta."

#: unpaper.py:166 unpaper.py:194
msgid "Bottom"
msgstr "Inferior"

#: unpaper.py:167
msgid "Use 'bottom' for scanning from the bottom."
msgstr "Utilitzeu 'bottom' per analitzar des de la part inferior."

#: unpaper.py:174
msgid "Align to edge"
msgstr "Alinea a la vora"

#: unpaper.py:175
msgid "Edge to which to align the page."
msgstr "Vora a la qual s'alinea la pàgina."

