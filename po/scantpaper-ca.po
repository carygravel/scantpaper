msgid "Use 'top' to align to the top edge."
msgstr "Utilitzeu 'top' per alinear a la vora superior."

#: unpaper.py:190
msgid "Use 'right' to align to the right edge."
msgstr "Utilitzeu 'right' per alinear a la vora dreta."

#: unpaper.py:195
msgid "Use 'bottom' to align to the bottom."
msgstr "Utilitzeu 'bottom' per alinear a la part inferior."

#: unpaper.py:201
msgid "Border margin"
msgstr "Marge de la vora"

#: unpaper.py:205
msgid "Vertical margin"
msgstr "Marge vertical"

#: unpaper.py:207
msgid ""
"Vertical distance to keep from the sheet edge when aligning a border area."
