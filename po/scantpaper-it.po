#: dialog/preferences.py:108
msgid ""
"If not set, switching to a flatbed scanner will force # pages to 1 and "
"single-sided mode."
msgstr ""
"Se non impostato, il passaggio a uno scanner in piano forzerà il numero di "
"pagine a 1 e la modalità a facciata singola."

