#: unpaper.py:69
msgid "Writing system"
msgstr "Skriftsystem"

#: unpaper.py:72
msgid "Left-to-right"
msgstr "Vänster till höger"

#: unpaper.py:74
msgid "Most writings systems, e.g. Latin, Greek, Cyrillic."
msgstr "De flesta skriftsystem, t.ex. latin, grekiska, kyrilliska."

#: unpaper.py:78
msgid "Right-to-left"
msgstr "Höger till vänster"

#: unpaper.py:79
msgid "Scripts like Arabic or Hebrew."
msgstr "Skript som arabiska eller hebreiska."

#: unpaper.py:87
msgid "No deskew"
msgstr "Ingen avskevning"

#: unpaper.py:88
msgid "Disable deskewing."
msgstr "Stäng av avskevning"

#: unpaper.py:93
msgid "No mask scan"
msgstr "Ingen skanningsmask"

#: unpaper.py:94
msgid "Disable mask detection."
msgstr "Stäng av maskavkänning"

#: unpaper.py:99
msgid "No mask centering"
msgstr "Ingen maskcentrering"

#: unpaper.py:100
msgid "Disable mask centering."
msgstr "Inaktivera maskcentrering."

#: unpaper.py:105
msgid "No black filter"
msgstr "Inget filter för svart"

#: unpaper.py:106
msgid "Disable black area scan."
msgstr "Stäng av skanning av svart yta"

#: unpaper.py:111
msgid "No gray filter"
msgstr "Inget filter för grått"

#: unpaper.py:112
msgid "Disable gray area scan."
msgstr "Stäng av skanning av grå yta"

#: unpaper.py:117
msgid "No noise filter"
msgstr "Inget skräpfilter"

#: unpaper.py:118
msgid "Disable noise filter."
msgstr "Stäng av skräpfilter"

#: unpaper.py:123
msgid "No blur filter"
msgstr "Inget oskärpefilter"

#: unpaper.py:124
msgid "Disable blur filter."
msgstr "Stäng av oskärpefilter"

#: unpaper.py:129
msgid "No border scan"
msgstr "Ingen ramskanning"

#: unpaper.py:130
msgid "Disable border scanning."
msgstr "Stäng av ramskanning"

#: unpaper.py:135
msgid "No border align"
msgstr "Ingen ramlinjering"

#: unpaper.py:137
msgid "Disable aligning of the area detected by border scanning."
msgstr "Stäng av linjering av yta detekterad med ramskanning"

#: unpaper.py:143
msgid "Deskew to edge"
msgstr "Avskeva till kant"

#: unpaper.py:145
msgid ""
"Edges from which to scan for rotation. Each edge of a mask can be used to "
"detect the mask's rotation. If multiple edges are specified, the average "
"value will be used, unless the statistical deviation exceeds --deskew-scan-"
"deviation."
msgstr ""
"Kant som bestämmer det skannades rotation. Varje kant av masken kan användas"
" för att bestämma maskens rotation. Om flera kanter anges används ett "
"genomsnittligt värde, om inte värdet är högre än --avskevning-skanning-"
"avvikelse."

#: unpaper.py:154
msgid "Use 'left' for scanning from the left edge."
msgstr "Använd \"vänster\" för att skanna från vänster kant."

#: unpaper.py:159
msgid "Use 'top' for scanning from the top edge."
msgstr "Använd \"Överkant\" för att skanna från överkanten."

#: unpaper.py:163 unpaper.py:191
msgid "Right"
msgstr "Höger"

#: unpaper.py:164
msgid "Use 'right' for scanning from the right edge."
msgstr "Använd \"höger\" för att skanna från höger kant."

#: unpaper.py:168 unpaper.py:196
msgid "Bottom"
msgstr "Nederkant"

#: unpaper.py:169
msgid "Use 'bottom' for scanning from the bottom."
msgstr "Använd \"Nederkant\" för att skanna från nedre kanten."

#: unpaper.py:176
msgid "Align to edge"
msgstr "Linjera till kant"

#: unpaper.py:177
msgid "Edge to which to align the page."
msgstr "Kant som sidan skall linjeras till."

#: unpaper.py:182
msgid "Use 'left' to align to the left edge."
msgstr "Använd \"vänster\" för att skanna från vänster kant."

#: unpaper.py:187
msgid "Use 'top' to align to the top edge."
msgstr "Använd \"Överst\" för att skanna från övre kanten."

#: unpaper.py:192
msgid "Use 'right' to align to the right edge."
msgstr "Använd \"höger\" för att skanna från högra kanten."

#: unpaper.py:197
msgid "Use 'bottom' to align to the bottom."
msgstr "Använd \"Nederkant\" för att skanna från nedre kanten."

#: unpaper.py:203
msgid "Border margin"
msgstr "Kantmarginal"

#: unpaper.py:207
msgid "Vertical margin"
msgstr "Vertikal marginal"

#: unpaper.py:209
msgid ""
"Vertical distance to keep from the sheet edge when aligning a border area."
msgstr "Marginal från den vertikala kanten vid linjering av kantyta."

#: unpaper.py:219
msgid "Horizontal margin"
msgstr "Horisontell marginal"

#: unpaper.py:221
msgid ""
"Horizontal distance to keep from the sheet edge when aligning a border area."
msgstr "Marginal från den horisontala kanten vid linjering av kantyta."

#: unpaper.py:233
msgid "White threshold"
msgstr "Tröskelvärde för vitt"

#: unpaper.py:235
msgid "Brightness ratio above which a pixel is considered white."
msgstr "Ovanför detta tröskelvärde anses en pixel vara vit."

#: unpaper.py:245
msgid "Black threshold"
msgstr "Tröskelvärde för svart"

#: unpaper.py:247
msgid ""
"Brightness ratio below which a pixel is considered black (non-gray). This is"
" used by the gray-filter. This value is also used when converting a "
"grayscale image to black-and-white mode."
msgstr ""
"Nedanför detta tröskelvärde anses en pixel vara svart, ej grå). Detta värde "
"används av gråskalefiltret. Värdet används också när en gråskalebild "
"konverteras till svart-vit."

#: unpaper.py:370
msgid "Deskew"
msgstr "Avskeva"

#: unpaper.py:374
msgid "Border"
msgstr "Marginal"

#: unpaper.py:385
msgid "Filters"
msgstr "Filter"

