#: config.py:312
#, python-format
msgid ""
"The settings file %(filename)s could not be read in full. These settings "
"were restored: %(settings)s. The rest were reset to their defaults. A backup"
" has been saved as %(backup)s."
msgstr ""
"Não foi possível ler integralmente o ficheiro de definições %(filename)s. "
"Estas definições foram restauradas: %(settings)s. As restantes foram "
"repostas nos valores predefinidos. Foi guardada uma cópia de segurança como "
"%(backup)s."

#: config.py:323
#, python-format
