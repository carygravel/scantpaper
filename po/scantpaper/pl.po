#: dialog/preferences.py:414
#, python-format
msgid ""
"Use %%i and %%o for the input and output filenames respectively,\n"
"or a single %%i if the image is to be modified in-place.\n"
"\n"
"The other variable available is:\n"
"%%r resolution"
msgstr ""
"Użyj %%i i %%o odpowiednio dla nazw plików wejściowych i wyjściowych,\n"
"lub pojedynczego %%i, jeśli obraz ma być modyfikowany w miejscu.\n"
"\n"
