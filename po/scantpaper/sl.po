#: unpaper.py:168 unpaper.py:196
msgid "Bottom"
msgstr "Dno"

#: unpaper.py:169
msgid "Use 'bottom' for scanning from the bottom."
msgstr "Uporabi 'dno' za skeniranje s spodnjega robu."

#: unpaper.py:176
msgid "Align to edge"
msgstr "Poravnaj to roba"

#: unpaper.py:177
msgid "Edge to which to align the page."
msgstr "Rob do katerega bo stran poravnana."

