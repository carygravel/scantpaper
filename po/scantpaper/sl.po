msgstr "Uporabi 'desno' za poravnavo ob desne robu."

#: unpaper.py:197
msgid "Use 'bottom' to align to the bottom."
msgstr "Uporabi 'dno' za poravnavo ob spodnjem robu."

#: unpaper.py:203
msgid "Border margin"
msgstr "Odmik roba"

#: unpaper.py:207
msgid "Vertical margin"
msgstr "Navpični odmik"

