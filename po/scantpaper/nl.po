#: dialog/preferences.py:194
msgid ""
"strftime codes, e.g.:\n"
"%Y\tcurrent year\n"
"\n"
"with the following additions:\n"
"%Da\tauthor\n"
"%De\tfilename extension\n"
"%Dk\tkeywords\n"
"%Ds\tsubject\n"
"%Dt\ttitle\n"
"\n"
"All document date codes use strftime codes with a leading D, e.g.:\n"
"%DY\tdocument year\n"
"%Dm\tdocument month\n"
"%Dd\tdocument day\n"
msgstr ""
"strftime-codes, bv.:\n"
"%Y\tlopend jaar\n"
"\n"
"met de volgende toevoegingen:\n"
"%Da\tauteur\n"
"%De\tbestandsextensie\n"
"%Dk\tzoekwoorden\n"
"%Ds\tonderwerp\n"
"%Dt\ttitel\n"
"\n"
"Alle datums-codes voor documenten gebruiken strftime-codes met een "
"voorafgaande D, bv.:\n"
"%DY\tdocumentjaar\n"
"%Dm\tdocumentmaand\n"
"%Dd\tdocumentdag\n"

