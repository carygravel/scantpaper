msgid "Writing system"
msgstr "Système d’écriture"

#: unpaper.py:72
msgid "Left-to-right"
msgstr "De gauche à droite"

#: unpaper.py:74
msgid "Most writings systems, e.g. Latin, Greek, Cyrillic."
msgstr "La plupart des systèmes d’écriture, par ex. latin, grec, cyrillique."

#: unpaper.py:78
msgid "Right-to-left"
msgstr "De droite à gauche"

#: unpaper.py:79
msgid "Scripts like Arabic or Hebrew."
msgstr "Écritures comme l’arabe ou l’hébreu."

#: unpaper.py:87
msgid "No deskew"
msgstr "Pas de réalignement"

#: unpaper.py:88
msgid "Disable deskewing."
msgstr ""
"Supprime la rotation automatique de l'image pour réaligner le texte "
"horizontalement"

#: unpaper.py:93
msgid "No mask scan"
msgstr "Pas de masque"

#: unpaper.py:94
msgid "Disable mask detection."
msgstr "Ne pas tenir compte du masque"

#: unpaper.py:99
msgid "No mask centering"
msgstr "Aucun centrage de masque"

#: unpaper.py:100
msgid "Disable mask centering."
msgstr "Désactiver le centrage du masque."

#: unpaper.py:105
msgid "No black filter"
msgstr "Pas de filtre noir"

#: unpaper.py:106
msgid "Disable black area scan."
msgstr "Ne pas détecter les aires noires"

#: unpaper.py:111
msgid "No gray filter"
msgstr "Pas de filtre gris"

#: unpaper.py:112
msgid "Disable gray area scan."
msgstr "Ne pas détecter les aires grises"

#: unpaper.py:117
msgid "No noise filter"
msgstr "Pas de filtre du bruit"

#: unpaper.py:118
msgid "Disable noise filter."
msgstr "Supprime le filtre pour diminuer le bruit"

#: unpaper.py:123
msgid "No blur filter"
msgstr "Pas de détection des pixels isolés"

#: unpaper.py:124
msgid "Disable blur filter."
msgstr "Désactive le filtre de suppression des pixels isolés"

#: unpaper.py:129
msgid "No border scan"
msgstr "Pas de détection des bords"

#: unpaper.py:130
msgid "Disable border scanning."
msgstr "Désactive la détection automatique des bords"

#: unpaper.py:135
msgid "No border align"
msgstr "Pas d'alignement des bords"

#: unpaper.py:137
msgid "Disable aligning of the area detected by border scanning."
msgstr ""
"Désactive l'alignement automatique de l'aire scannée par détection des bords"

#: unpaper.py:143
msgid "Deskew to edge"
msgstr "Auto-rotation de l'image"

#: unpaper.py:145
msgid ""
"Edges from which to scan for rotation. Each edge of a mask can be used to "
"detect the mask's rotation. If multiple edges are specified, the average "
"value will be used, unless the statistical deviation exceeds --deskew-scan-"
"deviation."
msgstr ""
"Bords de l'image d'où partir pour chercher à effectuer une rotation "
"permettant d'aligner automatiquement le texte à l'horizontale. Chaque bord "
"peut être utilisé pour déterminer la rotation à appliquer au masque, et une "
"valeur moyenne sera utilisée. (option --deskew-scan-direction de unpaper)"

#: unpaper.py:154
msgid "Use 'left' for scanning from the left edge."
msgstr "Utilisez 'gauche' pour scanner depuis le bord gauche."

#: unpaper.py:159
msgid "Use 'top' for scanning from the top edge."
msgstr "Utilisez 'haut' pour scanner depuis le bord supérieur."

#: unpaper.py:163 unpaper.py:191
msgid "Right"
msgstr "Droite"

#: unpaper.py:164
msgid "Use 'right' for scanning from the right edge."
msgstr "Utiliser \"droite\" pour scanner à partir du bord droit"

#: unpaper.py:168 unpaper.py:196
msgid "Bottom"
msgstr "Bas"

#: unpaper.py:169
msgid "Use 'bottom' for scanning from the bottom."
msgstr "Utiliser \"bas\" pour scanner à partir du bas"

#: unpaper.py:176
msgid "Align to edge"
msgstr "Aligner au bord"

#: unpaper.py:177
msgid "Edge to which to align the page."
msgstr "Bord sur lequel aligner la page"

#: unpaper.py:182
msgid "Use 'left' to align to the left edge."
msgstr "Utiliser \"gauche\" pour aligner sur le bord gauche"

#: unpaper.py:187
msgid "Use 'top' to align to the top edge."
msgstr "Utilisez 'haut' pour aligner sur le bord supérieur."

#: unpaper.py:192
msgid "Use 'right' to align to the right edge."
msgstr "Utilisez 'droite' pour aligner sur le bord droit."

#: unpaper.py:197
msgid "Use 'bottom' to align to the bottom."
msgstr "Utilisez 'bas' pour aligner sur le bas de l'image."

#: unpaper.py:203
msgid "Border margin"
msgstr "Taille des bordures"

#: unpaper.py:207
msgid "Vertical margin"
msgstr "Marges verticales"

#: unpaper.py:209
msgid ""
"Vertical distance to keep from the sheet edge when aligning a border area."
msgstr "Taille verticale de la bordure à aligner avec les côtés de la feuille"

#: unpaper.py:219
msgid "Horizontal margin"
msgstr "Marges horizontales"

#: unpaper.py:221
msgid ""
"Horizontal distance to keep from the sheet edge when aligning a border area."
msgstr ""
"Taille horizontale de la bordure à aligner avec les côtés de la feuille"

#: unpaper.py:233
msgid "White threshold"
msgstr "Seuil pour les blancs"

#: unpaper.py:235
msgid "Brightness ratio above which a pixel is considered white."
msgstr ""
"Rapport de luminosité au dessus duquel un pixel est considéré comme blanc."

#: unpaper.py:245
msgid "Black threshold"
msgstr "Seuil pour les noirs"

#: unpaper.py:247
msgid ""
"Brightness ratio below which a pixel is considered black (non-gray). This is"
" used by the gray-filter. This value is also used when converting a "
"grayscale image to black-and-white mode."
msgstr ""
"Rapport de luminosité en dessous duquel un pixel est considéré comme noir "
"(non gris). Cette valeur est utilisée par le filtre des gris et pour "
"convertir une image en niveaux de gris en une image noire et blanc."

