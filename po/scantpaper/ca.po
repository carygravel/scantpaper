msgid "No mask scan"
msgstr "Escaneig sense màscara"

#: unpaper.py:94
msgid "Disable mask detection."
msgstr "Desactiva la màscara de detecció"

#: unpaper.py:99
msgid "No mask centering"
msgstr "Sense centratge de màscara"

#: unpaper.py:100
msgid "Disable mask centering."
msgstr "Desactiva el centratge de la màscara."

#: unpaper.py:105
msgid "No black filter"
msgstr "Cap filtre de negre"

#: unpaper.py:106
msgid "Disable black area scan."
msgstr "Desactiva escaneig d'àrea de negre"

#: unpaper.py:111
msgid "No gray filter"
msgstr "Cap filtre de grisos"

#: unpaper.py:112
msgid "Disable gray area scan."
msgstr "Desactiva escaneig d'àrea de grisos"

#: unpaper.py:117
msgid "No noise filter"
msgstr "Cap filtre de soroll"

#: unpaper.py:118
msgid "Disable noise filter."
msgstr "DEsactiva el filtre de soroll"

#: unpaper.py:123
msgid "No blur filter"
msgstr "Sense filtre de desenfocament"

#: unpaper.py:124
msgid "Disable blur filter."
msgstr "Desactiva el filtre de desenfocament."

#: unpaper.py:129
msgid "No border scan"
msgstr "Escaneig sense vores"

#: unpaper.py:130
msgid "Disable border scanning."
msgstr "Desactiva l'escaneig de vores."

#: unpaper.py:135
msgid "No border align"
msgstr "Sense alineació de la vora"

#: unpaper.py:137
msgid "Disable aligning of the area detected by border scanning."
msgstr "Desactiva l'alineació de l'àrea detectada per l'escaneig de vores."

#: unpaper.py:143
msgid "Deskew to edge"
msgstr "Corregeix la inclinació fins a la vora"

#: unpaper.py:145
msgid ""
"Edges from which to scan for rotation. Each edge of a mask can be used to "
"detect the mask's rotation. If multiple edges are specified, the average "
"value will be used, unless the statistical deviation exceeds --deskew-scan-"
"deviation."
msgstr ""
"Vores a partir de les quals escanejar la rotació. Cada vora d'una màscara es"
" pot utilitzar per detectar la rotació de la màscara. Si s'especifiquen "
"diverses vores, s'utilitzarà el valor mitjà, tret que la desviació "
"estadística superi --deskew-scan-deviation."

#: unpaper.py:154
msgid "Use 'left' for scanning from the left edge."
msgstr "Utilitzeu 'left' per escanejar des de la vora esquerra."

#: unpaper.py:159
msgid "Use 'top' for scanning from the top edge."
msgstr "Utilitzeu 'top' per escanejar des de la vora superior."

#: unpaper.py:163 unpaper.py:191
msgid "Right"
msgstr "Dreta"

#: unpaper.py:164
msgid "Use 'right' for scanning from the right edge."
msgstr "Utilitzeu 'right' per escanejar des de la vora dreta."

#: unpaper.py:168 unpaper.py:196
msgid "Bottom"
msgstr "Inferior"

#: unpaper.py:169
msgid "Use 'bottom' for scanning from the bottom."
msgstr "Utilitzeu 'bottom' per escanejar des de la part inferior."

#: unpaper.py:176
msgid "Align to edge"
msgstr "Alinea a la vora"

#: unpaper.py:177
msgid "Edge to which to align the page."
msgstr "Vora a la qual alinear la pàgina."

#: unpaper.py:182
msgid "Use 'left' to align to the left edge."
msgstr "Utilitzeu 'left' per alinear a la vora esquerra."

#: unpaper.py:187
msgid "Use 'top' to align to the top edge."
msgstr "Utilitza 'top' per alinear amb la vora superior."

#: unpaper.py:192
msgid "Use 'right' to align to the right edge."
msgstr "Utilitzeu 'right' per alinear a la vora dreta."

#: unpaper.py:197
msgid "Use 'bottom' to align to the bottom."
msgstr "Utilitzeu 'bottom' per alinear a la part inferior."

#: unpaper.py:203
msgid "Border margin"
msgstr "Marge de la vora"

#: unpaper.py:207
msgid "Vertical margin"
msgstr "Marge vertical"

#: unpaper.py:209
msgid ""
"Vertical distance to keep from the sheet edge when aligning a border area."
msgstr ""
"Distància vertical que s'ha de mantenir respecte de la vora del full en "
"alinear una àrea de vora."

#: unpaper.py:219
msgid "Horizontal margin"
msgstr "Marge horitzontal"

#: unpaper.py:221
msgid ""
"Horizontal distance to keep from the sheet edge when aligning a border area."
msgstr ""
"Distància horitzontal que cal mantenir respecte de la vora del full en "
"alinear una àrea de vora."

#: unpaper.py:233
msgid "White threshold"
msgstr "Llindar blanc"

#: unpaper.py:235
msgid "Brightness ratio above which a pixel is considered white."
msgstr "Ràtio de brillantor per sobre de la qual un píxel es considera blanc."

#: unpaper.py:245
msgid "Black threshold"
msgstr "Llindar de negre"

#: unpaper.py:247
msgid ""
"Brightness ratio below which a pixel is considered black (non-gray). This is"
" used by the gray-filter. This value is also used when converting a "
"grayscale image to black-and-white mode."
msgstr ""
"Relació de brillantor per sota de la qual un píxel es considera negre (no "
"gris). L'utilitza el filtre de grisos. Aquest valor també s'utilitza quan es"
" converteix una imatge en escala de grisos al mode blanc i negre."

#: unpaper.py:370
msgid "Deskew"
msgstr "Redreçar"

#: unpaper.py:374
msgid "Border"
msgstr "Contorn"

