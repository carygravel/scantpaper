msgid "No deskew"
msgstr "Ingen oppretting av forskyvning"

#: unpaper.py:88
msgid "Disable deskewing."
msgstr "Deaktiver oppretting av forskyvning"

#: unpaper.py:93
msgid "No mask scan"
msgstr "Ingen maske-skanning"

#: unpaper.py:94
msgid "Disable mask detection."
msgstr "Deaktiver maskegjenkjenning."

#: unpaper.py:99
msgid "No mask centering"
msgstr "Ingen maskesentrering"

#: unpaper.py:100
msgid "Disable mask centering."
msgstr "Deaktiver maskesentrering."

#: unpaper.py:105
msgid "No black filter"
msgstr "Ingen sort-filter"

#: unpaper.py:106
msgid "Disable black area scan."
msgstr "Deaktiver skanning av sorte områder."

#: unpaper.py:111
msgid "No gray filter"
msgstr "Ingen gråfilter"

#: unpaper.py:112
msgid "Disable gray area scan."
msgstr "Deaktiver skanning av grå områder."

#: unpaper.py:117
msgid "No noise filter"
msgstr "Ingen støyfilter"

#: unpaper.py:118
msgid "Disable noise filter."
msgstr "Deaktiver støyfilter."

