msgstr "Ez desokertu (ez biratu aurreko posiziora)"

#: unpaper.py:88
msgid "Disable deskewing."
msgstr "Desgaitu desokertu (desgaitu 'ez biratu aurreko posiziora')"

#: unpaper.py:93
msgid "No mask scan"
msgstr "Ez egin maskara eskaneatzea"

#: unpaper.py:94
msgid "Disable mask detection."
msgstr "Desgaitu maskara detekzioa."

#: unpaper.py:99
msgid "No mask centering"
msgstr "Maskararen zentratzerik ez"

#: unpaper.py:100
msgid "Disable mask centering."
msgstr "Desgaitu maskararen zentratzea."

#: unpaper.py:105
msgid "No black filter"
msgstr "Iragazki beltzik ez"

#: unpaper.py:106
msgid "Disable black area scan."
msgstr "Desgaitu azalera beltzaren eskaneatzea."

#: unpaper.py:111
msgid "No gray filter"
msgstr "Iragazki grisik ez"

#: unpaper.py:112
msgid "Disable gray area scan."
msgstr "Desgaitu azalera grisaren eskaneatzea."

#: unpaper.py:117
msgid "No noise filter"
msgstr "Zarata iragazkirik ez"

#: unpaper.py:118
msgid "Disable noise filter."
msgstr "Desgaitu zarata iragazkia."

#: unpaper.py:123
msgid "No blur filter"
msgstr "Ez dago lausotze iragazkirik"

#: unpaper.py:124
msgid "Disable blur filter."
msgstr "Desgaitu lausotze iragazkia."

#: unpaper.py:129
msgid "No border scan"
msgstr "Ez eskaneatu bazterra"

#: unpaper.py:130
msgid "Disable border scanning."
msgstr "Desgaitu bazterretako eskaneatzea."

#: unpaper.py:135
msgid "No border align"
msgstr "Ez lerrokatu bazterra"

#: unpaper.py:137
msgid "Disable aligning of the area detected by border scanning."
msgstr ""
"Desgaitu lerrokatzeko aukera bazterretako eskaneatzeak detektatu duen "
"azaleran."

#: unpaper.py:143
msgid "Deskew to edge"
msgstr "Desokertu ertzeraino"

#: unpaper.py:145
msgid ""
"Edges from which to scan for rotation. Each edge of a mask can be used to "
"detect the mask's rotation. If multiple edges are specified, the average "
"value will be used, unless the statistical deviation exceeds --deskew-scan-"
"deviation."
msgstr ""
"Biratzeko behar diren eskaneatze ertzak. Maskara bateko ertz bakoitza erabil"
" daiteke maskararen biraketa hautemateko. Hainbat ertz zehazturik baldin "
"badaude, batez besteko balioa erabiliko da, desbideratze estatistikoak ez "
"badu hauxe gainditzen: --desokertu-eskaneatze-desbiderapena."

#: unpaper.py:154
msgid "Use 'left' for scanning from the left edge."
msgstr "Erabili 'ezkerretik' ezkerreko ertzetik eskaneatzeko."

#: unpaper.py:159
msgid "Use 'top' for scanning from the top edge."
msgstr "Erabili 'gainetik' gaineko ertzetik eskaneatzeko."

#: unpaper.py:163 unpaper.py:191
msgid "Right"
msgstr "Eskuina"

#: unpaper.py:164
msgid "Use 'right' for scanning from the right edge."
msgstr "Erabili 'eskuinetik' eskuineko ertzetik eskaneatzeko."

#: unpaper.py:168 unpaper.py:196
msgid "Bottom"
msgstr "Behe-behean"

#: unpaper.py:169
msgid "Use 'bottom' for scanning from the bottom."
msgstr "Erabili 'azpitik' beheko ertzetik eskaneatzeko."

#: unpaper.py:176
msgid "Align to edge"
msgstr "Lerrokatu ertzean"

#: unpaper.py:177
msgid "Edge to which to align the page."
msgstr "Orrialdea lerrokatzeko; ertz honekin."

#: unpaper.py:182
msgid "Use 'left' to align to the left edge."
msgstr "Erabili 'ezkerretik' ezkerreko ertzetik lerrokatzeko."

#: unpaper.py:187
msgid "Use 'top' to align to the top edge."
msgstr "Erabili 'gainaldetik' goiko ertzetik lerrokatzeko."

#: unpaper.py:192
msgid "Use 'right' to align to the right edge."
msgstr "Erabili 'eskuinetik' eskuineko ertzetik lerrokatzeko."

#: unpaper.py:197
msgid "Use 'bottom' to align to the bottom."
msgstr "Erabili 'azpitik' beheko ertzetik lerrokatzeko."

#: unpaper.py:203
msgid "Border margin"
msgstr "Ertzeko marjina"

#: unpaper.py:207
msgid "Vertical margin"
msgstr "Marjin bertikala"

#: unpaper.py:209
msgid ""
"Vertical distance to keep from the sheet edge when aligning a border area."
msgstr ""
"Orriaren ertzean gorde behar den distantzia bertikala bazterreko azalera "
"lerrokatzerakoan."

#: unpaper.py:219
msgid "Horizontal margin"
msgstr "Marjin horizontala"

#: unpaper.py:221
msgid ""
"Horizontal distance to keep from the sheet edge when aligning a border area."
msgstr ""
"Orriaren ertzean gorde behar den distantzia horizontala bazterreko azalera "
"lerrokatzerakoan."

#: unpaper.py:233
msgid "White threshold"
msgstr "Atalase zuria"

#: unpaper.py:235
msgid "Brightness ratio above which a pixel is considered white."
msgstr "Distira maila non hortik gora pixel bat zuritzat hartuko da."

#: unpaper.py:245
msgid "Black threshold"
msgstr "Atalase beltza"

#: unpaper.py:247
msgid ""
"Brightness ratio below which a pixel is considered black (non-gray). This is"
" used by the gray-filter. This value is also used when converting a "
"grayscale image to black-and-white mode."
msgstr ""
"Distira maila non horren azpitik pixel bat belztzat hartuko da (ez "
"gristzat). Aukera hau gris-iragazkiak erabili ohi du.  Balio hau gris-"
"eskalako irudi bat zuri-beltzeko irudi modura bihurtzen denean ere erabili "
"ohi da."

