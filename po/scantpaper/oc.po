#: unpaper.py:40
msgid "Layout"
msgstr "Disposicion"

#: unpaper.py:43
msgid "Single"
msgstr "Celibatari"

#: unpaper.py:45
msgid "One page per sheet, oriented upwards without rotation."
msgstr "Una pagina per fuèlh, orientada cap amont sens rotacion."

#: unpaper.py:49
msgid "Double"
msgstr "Doble"

#: unpaper.py:51
msgid ""
"Two pages per sheet, landscape orientation (one page on the left half, one "
"page on the right half)."
msgstr ""
"Doas paginas per fuèlh, orientacion païsatge (una pagina sus la mitat "
"esquèrra, una pagina sus la mitat drecha)."

#: unpaper.py:60
msgid "# Output pages"
msgstr "# Paginas de sortida"

#: unpaper.py:61
msgid "Number of pages to output."
msgstr "Nombre de paginas de sortir."

#: unpaper.py:69
msgid "Writing system"
msgstr "Sistèma d'escritura"

#: unpaper.py:72
msgid "Left-to-right"
msgstr "D'esquèrra a dreita"

#: unpaper.py:74
msgid "Most writings systems, e.g. Latin, Greek, Cyrillic."
msgstr ""
"La màger part dels sistèmas d'escritura, per exemple lo latin, lo grèc, lo "
"cirillic."

#: unpaper.py:78
msgid "Right-to-left"
msgstr "De drecha a esquèrra"

#: unpaper.py:79
msgid "Scripts like Arabic or Hebrew."
msgstr "Escripturas coma l'arabi o l'ebreu."

#: unpaper.py:87
msgid "No deskew"
msgstr "Sens redreçament"

#: unpaper.py:88
msgid "Disable deskewing."
msgstr "Desactivar lo redreçament."

#: unpaper.py:93
msgid "No mask scan"
msgstr "Escanejar sens masqueta"

#: unpaper.py:94
msgid "Disable mask detection."
msgstr "Desactivar la deteccion de mascas."

#: unpaper.py:99
msgid "No mask centering"
msgstr "Sens centratge de la màsca"

#: unpaper.py:100
msgid "Disable mask centering."
msgstr "Desactivar lo centratge de la mascara."

#: unpaper.py:105
msgid "No black filter"
msgstr "Cap de filtre negre"

#: unpaper.py:106
msgid "Disable black area scan."
msgstr "Desactivar l'escan de la zòna negra."

#: unpaper.py:111
msgid "No gray filter"
msgstr "Sense filtre gris"

#: unpaper.py:112
msgid "Disable gray area scan."
msgstr "Desactivar l'escan de la zòna grisa."

#: unpaper.py:117
msgid "No noise filter"
msgstr "Cap de filtre de bruch"

#: unpaper.py:118
msgid "Disable noise filter."
msgstr "Desactivar lo filtre de bruch."

#: unpaper.py:123
msgid "No blur filter"
msgstr "Cap de filtre de borrolament"

#: unpaper.py:124
msgid "Disable blur filter."
msgstr "Desactivar lo filtre de floutatge."

#: unpaper.py:129
msgid "No border scan"
msgstr "Escan sense bord"

#: unpaper.py:130
msgid "Disable border scanning."
msgstr "Desactivar l'escanament de la bòrda."

#: unpaper.py:135
msgid "No border align"
msgstr "Alinhament sens bordadura"

#: unpaper.py:137
msgid "Disable aligning of the area detected by border scanning."
msgstr ""
"Desactivar l'alinhament de l'airal detectat per l'escanejament de la "
"bordadura."

#: unpaper.py:143
msgid "Deskew to edge"
msgstr "Redreçar cap al bòrd"

#: unpaper.py:145
msgid ""
"Edges from which to scan for rotation. Each edge of a mask can be used to "
"detect the mask's rotation. If multiple edges are specified, the average "
"value will be used, unless the statistical deviation exceeds --deskew-scan-"
"deviation."
msgstr ""
"Bòrds a partir dels quals escanar la rotacion. Cada bòrd d'una màscara pòt "
"èsser utilizat per detectar la rotacion de la màscara. Se mai d'un bòrd es "
"especificat, la valor mejana serà utilizada, levat se la desviacion "
"estatistica depassa --deskew-scan-deviation."

#: unpaper.py:154
msgid "Use 'left' for scanning from the left edge."
msgstr "Utilizatz 'left' per escanar a partir del bòrd esquèr."

#: unpaper.py:159
msgid "Use 'top' for scanning from the top edge."
msgstr "Utilizatz 'top' per escanar dempuèi lo bòrd superior."

#: unpaper.py:163 unpaper.py:191
msgid "Right"
msgstr "Drecha"

#: unpaper.py:164
msgid "Use 'right' for scanning from the right edge."
msgstr "Utilizatz 'right' per escanejar dempuèi lo bòrd drech."

#: unpaper.py:168 unpaper.py:196
msgid "Bottom"
msgstr "Bas"

#: unpaper.py:169
msgid "Use 'bottom' for scanning from the bottom."
msgstr "Utilizatz 'bottom' per escanar dempuèi lo bas."

#: unpaper.py:176
msgid "Align to edge"
msgstr "Alinhar al bòrd"

#: unpaper.py:177
msgid "Edge to which to align the page."
msgstr "Bòrd al qual alinhar la pagina."

#: unpaper.py:182
msgid "Use 'left' to align to the left edge."
msgstr "Utilizatz 'left' per alinhar al bòrd esquèr."

#: unpaper.py:187
msgid "Use 'top' to align to the top edge."
msgstr "Utilizatz 'top' per alinhar al bòrd superior."

#: unpaper.py:192
msgid "Use 'right' to align to the right edge."
msgstr "Utilizatz 'right' per alinhar al marge drech."

#: unpaper.py:197
msgid "Use 'bottom' to align to the bottom."
msgstr "Utilizatz 'bottom' per alinhar al bas."

#: unpaper.py:203
msgid "Border margin"
msgstr "Marge de bordadura"

#: unpaper.py:207
msgid "Vertical margin"
msgstr "Marge vertical"

#: unpaper.py:209
msgid ""
"Vertical distance to keep from the sheet edge when aligning a border area."
msgstr ""
"Distància verticala a mantenir demest lo bòrd de la fuèlha al moment "
"d'alinhar una zòna de bordura."

#: unpaper.py:219
msgid "Horizontal margin"
msgstr "Marge orizontal"

#: unpaper.py:221
msgid ""
"Horizontal distance to keep from the sheet edge when aligning a border area."
msgstr ""
"Distància orizontala de gardar dempuèi lo bòrd de la fuèlha a l'ora "
"d'alinhar una zòna de bordadura."

#: unpaper.py:233
msgid "White threshold"
msgstr "Limiar blanc"

#: unpaper.py:235
msgid "Brightness ratio above which a pixel is considered white."
msgstr ""
"Racion de luminositat a partir de la quala un pixèl es considerat blanc."

#: unpaper.py:245
msgid "Black threshold"
msgstr "Lindal negre"

#: unpaper.py:247
msgid ""
"Brightness ratio below which a pixel is considered black (non-gray). This is"
" used by the gray-filter. This value is also used when converting a "
"grayscale image to black-and-white mode."
msgstr ""
"Rapòrt de luminositat jos lo qual un pixèl es considerat negre (non gris). "
"Aquò es utilizat pel filtre de gris. Aquesta valor es tanben utilizada quand"
" se convertís una imatge en escala de gris al mòde negre e blanc."

