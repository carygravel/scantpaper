msgstr "Тимчасова тека"

#: dialog/preferences.py:245
msgid "Browse"
msgstr "Огляд"

#: dialog/preferences.py:251
msgid "Select temporary directory"
msgstr "Вибрати тимчасову теку"

#: dialog/preferences.py:273
msgid "Warn if available space less than (Mb)"
msgstr "Попереджувати, якщо вільного місця менше, ніж (Мб)"

#: dialog/preferences.py:279
msgid ""
"Warn if the available space in the temporary directory is less than this "
