msgstr "У вихідному документі двухсторонняя печать"

#: dialog/pagecontrols.py:329
msgid "Side to scan"
msgstr "Яку сторону сканувати"

#: dialog/pagecontrols.py:332
msgid "Facing"
msgstr "Парні сторінки"

#: dialog/pagecontrols.py:332
msgid "Reverse"
msgstr "Зворотній порядок"

