#, python-format
msgid ""
"The setting %s is %r and cannot be used as %s, so it has been left unchanged."
msgstr ""
"Nastavení %s má hodnotu %r a nelze jej použít jako %s, proto bylo ponecháno "
"beze změny."

#: config.py:299
#, python-format
msgid ""
"The settings file %s could not be read in full. The following settings were "
"restored: %s. The rest were reset to their defaults. A backup of the "
"original file has been saved as %s."
msgstr ""
"Soubor s nastavením %s nebylo možné zcela přečíst. Následující nastavení "
"byla obnovena: %s. Zbytek byl vrácen na výchozí hodnoty. Záložní kopie "
"původního souboru byla uložena jako %s."

#: config.py:306
#, python-format
msgid ""
"The settings file %s could not be read, so all settings have been reset to "
"their defaults. A backup of the original file has been saved as %s."
msgstr ""
"Soubor s nastavením %s nebylo možné přečíst, proto bylo všechno nastavení "
"vráceno na výchozí hodnoty. Záložní kopie původního souboru byla uložena "
"jako %s."

