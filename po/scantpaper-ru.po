#: app_window.py:516
msgid "Save image and Save as PDF both require imagemagick"
msgstr "Для сохранения изображения и в PDF требуется ImageMagick"

#: app_window.py:517
msgid "Save image requires libtiff"
msgstr "Для сохранения изображения требуется libtiff"

#: app_window.py:518
msgid "Save as DjVu requires djvulibre-bin"
msgstr "Для сохранения в DjVu требуется djvulibre-bin"

