msgstr ""
"Предупреждать, если количество свободного места во временной папке меньше "
"указанного значения"

#: dialog/preferences.py:287
msgid "Blank threshold"
msgstr "Порог пустой страницы"

#: dialog/preferences.py:292
msgid "Threshold used for selecting blank pages"
msgstr "Пороговое значение, используемое для выявления пустых страниц"

#: dialog/preferences.py:300
msgid "Dark threshold"
msgstr "Порог тёмной страницы"

#: dialog/preferences.py:304
msgid "Threshold used for selecting dark pages"
msgstr "Пороговое значение для выявления тёмных страниц"

#: dialog/preferences.py:311
msgid "OCR output"
msgstr "Вывод OCR"

#: dialog/preferences.py:316
msgid "Replace"
msgstr "Заменять"

#: dialog/preferences.py:318
msgid "Replace the contents of the text buffer with that from the OCR output."
msgstr "Заменять содержимое текстового буфера на вывод распознанного текста."

#: dialog/preferences.py:321
msgid "Prepend"
msgstr "Добавлять в начало"

#: dialog/preferences.py:321
msgid "Prepend the OCR output to the text buffer."
msgstr "Помещать вывод распознанного текста в начало текстового буфера."

#: dialog/preferences.py:322
msgid "Append"
msgstr "Добавлять в конец"

#: dialog/preferences.py:322
msgid "Append the OCR output to the text buffer."
msgstr "Помещать вывод распознанного текста в конец текстового буфера"

#: dialog/preferences.py:329
msgid "Manage user-defined tools"
msgstr "Управление дополнительными инструментами"

#: dialog/preferences.py:352
#, python-format
msgid ""
"Use %i and %o for the input and output filenames respectively,\n"
"or a single %i if the image is to be modified in-place.\n"
"\n"
"The other variable available is:\n"
"%r resolution"
msgstr ""
"Используйте %i и %o для имён входного и выходного файлов соответственно,\n"
"или один %i, если изображение должно изменяться на месте.\n"
"\n"
"Доступна ещё одна переменная:\n"
"%r разрешение"

