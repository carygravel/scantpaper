msgstr "unpaper отсутствует"

#: app_window.py:528
msgid "OCR requires tesseract"
msgstr "Для OCR требуется tesseract"

#: app_window.py:543
msgid "PDF encryption requires qpdf"
msgstr "Для шифрования PDF требуется qpdf"

#: app_window.py:575
msgid "Warning: missing packages"
msgstr "Предупреждение: некоторые пакеты отсутствуют"

