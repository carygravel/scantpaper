msgstr "Desativar alinhamento da área detectada pela digitalização de bordas."

#: unpaper.py:141
msgid "Deskew to edge"
msgstr "Deskew até a borda"

#: unpaper.py:143
msgid ""
"Edges from which to scan for rotation. Each edge of a mask can be used to "
"detect the mask's rotation. If multiple edges are specified, the average "
"value will be used, unless the statistical deviation exceeds --deskew-scan-"
"deviation."
msgstr ""
"Bordas a serem examinadas para rotação. Cada borda de uma máscara pode ser "
"usada para detectar a rotação da máscara. Se múltiplas bordas forem "
"especificadas, o valor médio será utilizado ao menos que o desvio "
"estatístico exceda --deskew-scan-deviation."

#: unpaper.py:152
msgid "Use 'left' for scanning from the left edge."
msgstr "Use \"esquerda\" para digitalizar pela borda esquerda."

#: unpaper.py:157
msgid "Use 'top' for scanning from the top edge."
msgstr "Use \"topo\" para digitalizar pela borda do topo."

#: unpaper.py:161 unpaper.py:189
msgid "Right"
msgstr "Direita"

#: unpaper.py:162
msgid "Use 'right' for scanning from the right edge."
msgstr "Use \"direita\" para digitalizar pela borda da direita."

#: unpaper.py:166 unpaper.py:194
msgid "Bottom"
msgstr "Inferior"

#: unpaper.py:167
msgid "Use 'bottom' for scanning from the bottom."
msgstr "Use \"fundo\" para digitalizar pela borda do fundo."

#: unpaper.py:174
msgid "Align to edge"
msgstr "Alinhar com a borda"

#: unpaper.py:175
msgid "Edge to which to align the page."
msgstr "Borda para qual alinhar a página"

#: unpaper.py:180
msgid "Use 'left' to align to the left edge."
msgstr "Use \"esquerda\" para alinhar à borda esquerda."

#: unpaper.py:185
msgid "Use 'top' to align to the top edge."
msgstr "Use \"acima\" para alinhar a borda superior."

#: unpaper.py:190
msgid "Use 'right' to align to the right edge."
msgstr "Use \"direita\" para alinhar à borda direita."

#: unpaper.py:195
msgid "Use 'bottom' to align to the bottom."
msgstr "Use \"abaixo\" para digitalizar a borda inferior."

