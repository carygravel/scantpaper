msgid "No mask centering"
msgstr "Sem centralização de máscara"

#: unpaper.py:98
msgid "Disable mask centering."
msgstr "Desativar a centralização de máscara."

#: unpaper.py:103
msgid "No black filter"
msgstr "Sem filtro de preto"

#: unpaper.py:104
msgid "Disable black area scan."
msgstr "Desativar a análise de áreas pretas."

#: unpaper.py:109
msgid "No gray filter"
msgstr "Sem filtro de cinzento"

#: unpaper.py:110
msgid "Disable gray area scan."
msgstr "Desativar a análise de áreas cinzentas."

#: unpaper.py:115
msgid "No noise filter"
msgstr "Sem filtro de ruído"

#: unpaper.py:116
msgid "Disable noise filter."
msgstr "Desativar o filtro de ruído."

