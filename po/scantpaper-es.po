msgid "Align to edge"
msgstr "Alinear al borde"

#: unpaper.py:175
msgid "Edge to which to align the page."
msgstr "Borde hacia el cual alinear la página."

#: unpaper.py:180
msgid "Use 'left' to align to the left edge."
msgstr "Use 'izquierda' para alinear a la izquierda."

#: unpaper.py:185
