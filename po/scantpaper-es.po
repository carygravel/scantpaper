msgstr "Use 'arriba' para alinear arriba."

#: unpaper.py:190
msgid "Use 'right' to align to the right edge."
msgstr "Use 'derecha' para alinear a la derecha."

#: unpaper.py:195
msgid "Use 'bottom' to align to the bottom."
msgstr "Usa 'abajo' para alinear abajo."

