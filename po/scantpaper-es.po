msgid "Right"
msgstr "Derecha"

#: unpaper.py:162
msgid "Use 'right' for scanning from the right edge."
msgstr "Usa 'Derecho' para escanear desde el borde derecho."

#: unpaper.py:166 unpaper.py:194
msgid "Bottom"
msgstr "Abajo"

#: unpaper.py:167
msgid "Use 'bottom' for scanning from the bottom."
msgstr "Usa 'Abajo' para escanear desde el borde inferior."

