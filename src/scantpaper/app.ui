        </child>
        <child>
          <object class="GtkButton" id="toolbutton_zoom_to_fit">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Zoom to fit</property>
            <property name="action_name">win.zoom-to-fit</property>
            <property name="icon-name">zoom-fit-best</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="toolbutton_zoom_in">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Zoom in</property>
            <property name="action_name">win.zoom-in</property>
            <property name="icon-name">zoom-in</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="toolbutton_zoom_out">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Zoom out</property>
            <property name="action_name">win.zoom-out</property>
            <property name="icon-name">zoom-out</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="toolbutton_rotate_270">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Rotate 90° anticlockwise</property>
            <property name="action_name">win.rotate-270</property>
            <property name="icon-name">stock-rotate-270</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="toolbutton_rotate_180">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Rotate 180°</property>
            <property name="action_name">win.rotate-180</property>
            <property name="icon-name">stock-rotate-180</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="toolbutton_rotate_90">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Rotate 90° clockwise</property>
            <property name="action_name">win.rotate-90</property>
            <property name="icon-name">stock-rotate-90</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="toolbutton_crop_selection">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Crop selection</property>
            <property name="action_name">win.crop-selection</property>
            <property name="icon-name">crop</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="toolbutton_quit">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Quit</property>
            <property name="action_name">win.quit</property>
            <property name="icon-name">application-exit</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkPaned" id="hpaned">
        <property name="orientation">horizontal</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkScrolledWindow" id="scwin_thumbs">
            <property name="hscrollbar_policy">automatic</property>
            <property name="vscrollbar_policy">automatic</property>
            <property name="has-frame">False</property>
          </object>
        </child>
        <child>
          <object class="GtkPaned" id="vpaned">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkNotebook" id="vnotebook"></object>
            </child>
            <child>
              <object class="GtkBox" id="edit_hbox">
                <property name="orientation">horizontal</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="progress_hbox">
        <property name="orientation">horizontal</property>
      </object>
    </child>
  </object>
</interface>
