<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!-- interface-requires gtk 4.0 -->
  <object class="GtkPopover" id="detail_popup">
    <property name="autohide">True</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkToggleButton" id="context_dragger">
            <property name="label" translatable="yes">Pan</property>
            <property name="action-name">win.tooltype</property>
            <property name="action-target">'dragger'</property>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="context_selector">
            <property name="label" translatable="yes">Select</property>
            <property name="action-name">win.tooltype</property>
            <property name="action-target">'selector'</property>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="context_selectordragger">
            <property name="label" translatable="yes">Select &amp; pan</property>
            <property name="action-name">win.tooltype</property>
            <property name="action-target">'selectordragger'</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="detail_zoom_100">
            <property name="label" translatable="yes">Zoom 100%</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="detail_zoom_to_fit">
            <property name="label" translatable="yes">Zoom to fit</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="detail_zoom_in">
            <property name="label" translatable="yes">Zoom in</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="detail_zoom_out">
            <property name="label" translatable="yes">Zoom out</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="detail_rotate_90">
            <property name="label" translatable="yes">Rotate 90° clockwise</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="detail_rotate_180">
            <property name="label" translatable="yes">Rotate 180°</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="detail_rotate_270">
            <property name="label" translatable="yes">Rotate 90° anticlockwise</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="detail_crop">
            <property name="label" translatable="yes">Crop</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="detail_cut">
            <property name="label" translatable="yes">Cut</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="detail_copy">
            <property name="label" translatable="yes">Copy</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="detail_paste">
            <property name="label" translatable="yes">Paste</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="detail_delete">
            <property name="label" translatable="yes">Delete</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="detail_properties">
            <property name="label" translatable="yes">Properties</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkPopover" id="thumb_popup">
    <property name="autohide">True</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkButton" id="thumb_save">
            <property name="label" translatable="yes">Save</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_email">
            <property name="label" translatable="yes">Email as PDF</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_print">
            <property name="label" translatable="yes">Print</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="thumb_select_all">
            <property name="label" translatable="yes">Select All</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_select_odd">
            <property name="label" translatable="yes">Select Odd</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_select_even">
            <property name="label" translatable="yes">Select Even</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_invert_selection">
            <property name="label" translatable="yes">Invert selection</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="thumb_rotate_90">
            <property name="label" translatable="yes">Rotate 90° clockwise</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_rotate_180">
            <property name="label" translatable="yes">Rotate 180°</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_rotate_270">
            <property name="label" translatable="yes">Rotate 90° anticlockwise</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="thumb_crop">
            <property name="label" translatable="yes">Crop</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="thumb_cut">
            <property name="label" translatable="yes">Cut</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_copy">
            <property name="label" translatable="yes">Copy</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_paste">
            <property name="label" translatable="yes">Paste</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="thumb_delete">
            <property name="label" translatable="yes">Delete</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="thumb_clear_ocr">
            <property name="label" translatable="yes">Clear OCR</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" />
        </child>
        <child>
          <object class="GtkButton" id="thumb_properties">
            <property name="label" translatable="yes">Properties</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkBox" id="main_vbox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkPopoverMenuBar" id="menubar">
        <property name="menu-model">
          <menu>
            <submenu>
              <attribute name="label" translatable="yes">_File</attribute>
              <section>
              <item>
                <attribute name="action">win.new</attribute>
                <attribute name="label" translatable="yes">_New</attribute>
              </item>
              <item>
                <attribute name="action">win.open</attribute>
                <attribute name="label" translatable="yes">_Open</attribute>
              </item>
              <item>
                <attribute name="action">win.open-session</attribute>
                <attribute name="label" translatable="yes">Open c_rashed session</attribute>
              </item>
              <item>
                <attribute name="action">win.scan</attribute>
                <attribute name="label" translatable="yes">S_can</attribute>
              </item>
              <item>
                <attribute name="action">win.save</attribute>
                <attribute name="label" translatable="yes">Save</attribute>
              </item>
              <item>
                <attribute name="action">win.email</attribute>
                <attribute name="label" translatable="yes">_Email as PDF</attribute>
              </item>
              <item>
                <attribute name="action">win.print</attribute>
                <attribute name="label" translatable="yes">_Print</attribute>
              </item>
              </section>
              <section>
              <item>
                <attribute name="action">win.quit</attribute>
                <attribute name="label" translatable="yes">_Quit</attribute>
              </item>
              </section>
            </submenu>
            <submenu>
              <attribute name="label" translatable="yes">_Edit</attribute>
              <section>
                <item>
                <attribute name="action">win.undo</attribute>
                <attribute name="label" translatable="yes">_Undo</attribute>
              </item>
              <item>
                <attribute name="action">win.redo</attribute>
                <attribute name="label" translatable="yes">_Redo</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="action">win.cut</attribute>
                <attribute name="label" translatable="yes">Cu_t</attribute>
              </item>
              <item>
                <attribute name="action">win.copy</attribute>
                <attribute name="label" translatable="yes">_Copy</attribute>
              </item>
              <item>
                <attribute name="action">win.paste</attribute>
                <attribute name="label" translatable="yes">_Paste</attribute>
              </item>
              <item>
                <attribute name="action">win.delete</attribute>
                <attribute name="label" translatable="yes">_Delete</attribute>
              </item>
            </section>
            <submenu>
              <attribute name="label" translatable="yes">_Select</attribute>
              <item>
                <attribute name="action">win.select-all</attribute>
                <attribute name="label" translatable="yes">_All</attribute>
              </item>
              <item>
                <attribute name="action">win.select-odd</attribute>
                <attribute name="label" translatable="yes">_Odd</attribute>
              </item>
              <item>
                <attribute name="action">win.select-even</attribute>
                <attribute name="label" translatable="yes">_Even</attribute>
              </item>
              <item>
                <attribute name="action">win.select-invert</attribute>
                <attribute name="label" translatable="yes">_Invert</attribute>
              </item>
              <item>
                <attribute name="action">win.select-blank</attribute>
                <attribute name="label" translatable="yes">_Blank</attribute>
              </item>
              <item>
                <attribute name="action">win.select-dark</attribute>
                <attribute name="label" translatable="yes">_Dark</attribute>
              </item>
              <item>
                <attribute name="action">win.select-modified</attribute>
                <attribute name="label" translatable="yes">_Modified</attribute>
              </item>
              <item>
                <attribute name="action">win.select-no-ocr</attribute>
                <attribute name="label" translatable="yes">_No OCR</attribute>
              </item>
            </submenu>
            <section>
              <item>
                <attribute name="action">win.clear-ocr</attribute>
                <attribute name="label" translatable="yes">_Clear OCR</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="action">win.properties</attribute>
                <attribute name="label" translatable="yes">Propert_ies</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="action">win.preferences</attribute>
                <attribute name="label" translatable="yes">Prefere_nces</attribute>
              </item>
            </section>
          </submenu>
          <submenu>
            <attribute name="label" translatable="yes">_View</attribute>
            <section>
              <item>
                <attribute name="label" translatable="yes">_Pan</attribute>
                <attribute name="action">win.tooltype</attribute>
                <attribute name="target">dragger</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">_Select</attribute>
                <attribute name="action">win.tooltype</attribute>
                <attribute name="target">selector</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">_Select &amp; pan</attribute>
                <attribute name="action">win.tooltype</attribute>
                <attribute name="target">selectordragger</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="label" translatable="yes">_Tabbed</attribute>
                <attribute name="action">win.viewtype</attribute>
                <attribute name="target">tabbed</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">_Split horizontally</attribute>
                <attribute name="action">win.viewtype</attribute>
                <attribute name="target">horizontal</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">_Split vertically</attribute>
                <attribute name="action">win.viewtype</attribute>
                <attribute name="target">vertical</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="label" translatable="yes">Edit text layer</attribute>
                <attribute name="action">win.editmode</attribute>
                <attribute name="target">text</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Edit annotations</attribute>
                <attribute name="action">win.editmode</attribute>
                <attribute name="target">annotation</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="action">win.zoom-100</attribute>
                <attribute name="label" translatable="yes">Zoom _100%</attribute>
              </item>
              <item>
                <attribute name="action">win.zoom-to-fit</attribute>
                <attribute name="label" translatable="yes">Zoom to _fit</attribute>
              </item>
              <item>
                <attribute name="action">win.zoom-in</attribute>
                <attribute name="label" translatable="yes">Zoom _in</attribute>
              </item>
              <item>
                <attribute name="action">win.zoom-out</attribute>
                <attribute name="label" translatable="yes">Zoom _out</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="action">win.rotate-90</attribute>
                <attribute name="label" translatable="yes">Rotate 90° clockwise</attribute>
              </item>
              <item>
                <attribute name="action">win.rotate-180</attribute>
                <attribute name="label" translatable="yes">Rotate 180°</attribute>
              </item>
              <item>
                <attribute name="action">win.rotate-270</attribute>
                <attribute name="label" translatable="yes">Rotate 90° anticlockwise</attribute>
              </item>
            </section>
            </submenu>
            <submenu>
              <attribute name="label" translatable="yes">_Tools</attribute>
              <section>
              <item>
                <attribute name="action">win.threshold</attribute>
                <attribute name="label" translatable="yes">_Threshold</attribute>
              </item>
              <item>
                <attribute name="action">win.brightness-contrast</attribute>
                <attribute name="label" translatable="yes">_Brightness / Contrast</attribute>
              </item>
              <item>
                <attribute name="action">win.negate</attribute>
                <attribute name="label" translatable="yes">_Negate</attribute>
              </item>
              <item>
                <attribute name="action">win.unsharp</attribute>
                <attribute name="label" translatable="yes">_Unsharp Mask</attribute>
              </item>
              <item>
                <attribute name="action">win.crop-dialog</attribute>
                <attribute name="label" translatable="yes">_Crop</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="action">win.unpaper</attribute>
                <attribute name="label" translatable="yes">_Clean up</attribute>
              </item>
              <item>
                <attribute name="action">win.split</attribute>
                <attribute name="label" translatable="yes">_Split</attribute>
              </item>
              <item>
                <attribute name="action">win.ocr</attribute>
                <attribute name="label" translatable="yes">_OCR</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="action">win.user-defined</attribute>
                <attribute name="label" translatable="yes">U_ser-defined</attribute>
              </item>
            </section>
            </submenu>
            <submenu>
              <attribute name="label" translatable="yes">_Help</attribute>
              <item>
                <attribute name="action">win.help</attribute>
                <attribute name="label" translatable="yes">_Help</attribute>
              </item>
              <item>
                <attribute name="action">win.about</attribute>
                <attribute name="label" translatable="yes">_About</attribute>
              </item>
            </submenu>
          </menu>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="toolbar">
        <property name="orientation">horizontal</property>
        <property name="can_focus">False</property>
        <child>
          <object class="GtkButton" id="toolbutton_new">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Clears all pages</property>
            <property name="action_name">win.new</property>
            <property name="icon-name">document-new</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="toolbutton_open">
            <property name="can_focus">False</property>
            <property name="tooltip_text" translatable="yes">Open images</property>
            <property name="action_name">win.open</property>
            <property name="icon-name">document-open</property>
            <property name="hexpand">False</property>
            <property name="vexpand">False</property>
          </object>
        </child>
        <child>
